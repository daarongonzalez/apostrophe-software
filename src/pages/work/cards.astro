---
// Design preview: the four Work card styles side by side, using real content.
// Not linked from the menu and kept out of search results.
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import WorkshopCard from '../../components/work/WorkshopCard.astro';
import PhotoCard from '../../components/work/PhotoCard.astro';
import { projects, workshops, sessionPhotos } from '../../data/work';
import { CARD_STYLE, type CardStyle } from '../../site';

const styles: { id: CardStyle; name: string; note: string; bg: string }[] = [
  {
    id: 'holo',
    name: 'Holo Foil',
    note: 'A thin gradient edge with a soft rainbow foil. The foil and a glare follow your pointer as the card tilts.',
    bg: 'plain',
  },
  {
    id: 'hollow',
    name: 'Hollow Glass',
    note: 'A gradient outline around a frosted, tinted gap, with the content floating inside. Calm, with only a slight tilt.',
    bg: 'mist',
  },
  {
    id: 'rare',
    name: 'Rare Frame',
    note: 'The most "trading card" of the four: a thick foil frame, a card type and number on top, and a solid offset shadow.',
    bg: 'surface',
  },
  {
    id: 'prism',
    name: 'Prism',
    note: 'A dark card whose gradient edge slowly turns, with a colored glow underneath. It speeds up on hover.',
    bg: 'plain',
  },
];

const project = projects[0];
const workshop = workshops[0];
const photo = sessionPhotos[0];
---
<Base
  title="Card styles — Apostrophe Software"
  description="Four card styles for the Work section, side by side."
  noindex
>
  <PageIntro eyebrow="Design preview" title="Card Styles" tint class="cards-intro">
    <p class="lead cards-intro__lead">Four takes on a collectible card for our work. Hover over a card to see it tilt and catch the light. Each style links to the full Work page drawn in that style.</p>
  </PageIntro>

  {styles.map((s, i) => (
    <section class:list={['style pad-x', `style--${s.bg}`]} id={s.id}>
      <div class="style__head">
        <div>
          <div class="eyebrow style__num">Option {String.fromCharCode(65 + i)}{s.id === CARD_STYLE && ' · In use now'}</div>
          <h2 class="heading style__name">{s.name}</h2>
          <p class="style__note">{s.note}</p>
        </div>
        <a href={`/work?card=${s.id}`} class="text-link style__link">See the full Work page →</a>
      </div>
      <div class="style__row">
        <ProjectCard project={project} num="01" variant={s.id} />
        <WorkshopCard workshop={workshop} num="01" variant={s.id} />
        <PhotoCard photo={photo} num="01" variant={s.id} />
      </div>
    </section>
  ))}
</Base>

<style>
  .cards-intro { padding-top: 64px; padding-bottom: 52px; }
  .cards-intro :global(.intro__title) { margin: 0 0 18px; font-size: clamp(34px, 4.2vw, 49px); }
  .cards-intro__lead { font-size: 19px; line-height: 1.5; max-width: 34em; }

  .style { padding-top: 80px; padding-bottom: 96px; border-bottom: 1px solid var(--border); }
  .style--surface { background: var(--surface); }
  .style--mist {
    background:
      radial-gradient(50% 70% at 10% 20%, #B9DDFB 0%, rgba(185,221,251,0) 70%),
      radial-gradient(45% 65% at 90% 30%, #B2F0E2 0%, rgba(178,240,226,0) 70%),
      radial-gradient(60% 70% at 50% 110%, #9ED8F2 0%, rgba(158,216,242,0) 70%),
      #EEF7FA;
  }

  .style__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 44px;
  }
  .style__num { color: var(--teal-deep); margin-bottom: 12px; }
  .style__name { margin: 0 0 10px; font-size: clamp(28px, 3.2vw, 36px); line-height: 1.05; }
  .style__note { font-size: 17px; line-height: 1.55; color: var(--slate); max-width: 36em; }
  .style__link { align-self: auto; flex: none; }

  .style__row {
    display: grid;
    grid-template-columns: 1fr 1.3fr .78fr;
    gap: 36px;
    align-items: start;
  }
  /* Cards size to their content here instead of filling the row. */
  .style__row > :global(.cf) { height: auto; min-width: 0; }
  .style__row > :global(.photo--portrait) { aspect-ratio: 3 / 4; }

  @media (max-width: 1000px) {
    .style__row { grid-template-columns: 1fr 1fr; }
    .style__row > :global(:nth-child(2)) { grid-column: 1 / -1; grid-row: 1; }
  }
  @media (max-width: 700px) {
    .style { padding-top: 60px; padding-bottom: 72px; }
    .style__head { flex-direction: column; align-items: flex-start; gap: 20px; }
    .style__row { grid-template-columns: 1fr; gap: 32px; }
    .style__row > :global(:nth-child(2)) { grid-row: auto; }
  }
</style>
