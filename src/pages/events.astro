---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ComingSoon from '../components/ComingSoon.astro';
import CtaBand from '../components/CtaBand.astro';
import { FEATURES, SITE } from '../site';

const formats = [
  { name: 'Workshops', count: '2 upcoming', mesh: ['15% 85%', '85% 15%'] },
  { name: 'Leadership briefings', count: '1 upcoming', mesh: ['85% 90%', '10% 10%'] },
  { name: 'Cohorts', count: '1 upcoming', mesh: ['50% 110%', '90% 0%'] },
];

const calendar = [
  { date: 'Sep 30', title: 'Prompt to Process: Ops Workshop', desc: 'Map one workflow, automate the ugliest step.', meta: 'Remote · 3 hrs', action: 'Register' },
  { date: 'Oct 22', title: 'Leadership Briefing: What AI Actually Costs', desc: 'Token math, vendor traps, and where the budget goes.', meta: 'Austin, TX · 90 min', action: 'Register' },
  { date: 'Nov 06', title: 'Cohort 07 starts — Enablement Sprint', desc: 'Three weeks with your team, on your codebase.', meta: 'Hybrid · 3 weeks', action: 'Apply' },
  { date: 'Sep 11', title: 'Evals for Non-Engineers', desc: 'Recording available to attendees.', meta: 'Remote · 2 hrs', action: null },
];
---
<Base
  title="Events — Apostrophe Software"
  description="Half-day workshops and on-site field days. Small rooms on purpose, and every seat gets to build."
  active="events"
>
  <PageIntro eyebrow="Events" title="It's Better to Build Together" tint class="events-intro">
    <p class="lead events-intro__lead">Half-day workshops, on-site field days. Small rooms on purpose and every seat gets to build along side others.</p>
  </PageIntro>

  {FEATURES.eventsList ? (
    <section class="events pad-x">
      <div class="flagship">
        <div class="flagship__date">
          <div class="flagship__month">Oct</div>
          <div class="flagship__day">14</div>
          <div class="flagship__year">2026</div>
        </div>
        <div>
          <div class="flagship__kicker">Flagship · 2 days · In person</div>
          <h2 class="heading flagship__title">Agent Build Intensive — Dallas</h2>
          <p class="flagship__body">Bring one broken process. Leave with a working agent, an eval harness, and the runbook your team will maintain. 18 seats.</p>
        </div>
        <a href={SITE.bookingUrl} class="flagship__cta">Reserve a seat →</a>
      </div>

      <div class="formats">
        <h2 class="heading events__h2">Browse by format</h2>
        <div class="formats__grid">
          {formats.map((f) => (
            <div class="formats__item">
              <div class="formats__tile mesh" style={`--m1:${f.mesh[0]};--m2:${f.mesh[1]}`}></div>
              <div>
                <div class="formats__name">{f.name}</div>
                <div class="formats__count">{f.count}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="calendar__head">
        <h2 class="heading events__h2">Also on the calendar</h2>
        <span class="eyebrow calendar__season">Fall 2026</span>
      </div>
      <div class="calendar">
        {calendar.map((e) => (
          <div class:list={['calendar__row', { 'is-past': !e.action }]}>
            <div class="calendar__date">{e.date}</div>
            <div>
              <div class="calendar__title">{e.title}</div>
              <div class="calendar__desc">{e.desc}</div>
            </div>
            <div class="calendar__meta">{e.meta}</div>
            {e.action
              ? <a href={SITE.bookingUrl} class="calendar__btn">{e.action}</a>
              : <span class="calendar__past">Past</span>}
          </div>
        ))}
      </div>
    </section>
  ) : (
    <ComingSoon label="Events" />
  )}

  <CtaBand
    headline="Attend one of our events, or host one!"
    body="We run every workshop privately, built around your systems and your team's vocabulary."
    ctaLabel="Request a private date"
    ctaHref={SITE.bookingUrl}
  />
</Base>

<style>
  .events-intro { padding-top: 70px; padding-bottom: 56px; }
  .events-intro :global(.intro__title) {
    margin: 0 0 20px;
    font-size: clamp(34px, 4.2vw, 49px);
    max-width: 20em;
  }
  .events-intro__lead { font-size: 19px; line-height: 1.5; max-width: 34em; }

  /* Event list (hidden at launch) */
  .events { padding-top: 64px; padding-bottom: 24px; }
  .events__h2 { font-size: 29px; }
  .flagship {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 36px;
    align-items: center;
    margin: 8px 0 44px;
    padding: 38px 42px;
    background: var(--ink);
    border: 1.5px solid #3B3D40;
    transition: border-color .25s ease;
  }
  .flagship:hover { border-color: #7A8086; }
  .flagship__date { text-align: center; padding-right: 36px; border-right: 1px solid #3B3D40; font-family: var(--font-mono); }
  .flagship__month { font-size: 12.2px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--teal-bright); }
  .flagship__day { font-size: 46px; font-weight: 700; line-height: 1; color: var(--white); }
  .flagship__year { font-size: 12.2px; color: var(--footer-meta); margin-top: 4px; }
  .flagship__kicker { font-family: var(--font-mono); font-size: 11.8px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--teal-bright); margin-bottom: 10px; }
  .flagship__title { margin: 0 0 10px; font-size: 27px; color: var(--white); }
  .flagship__body { font-size: 16.5px; line-height: 1.5; color: #D0D3D6; max-width: 40em; }
  .flagship__cta { flex: none; background: var(--gradient); color: var(--white); padding: 16px 30px; font-size: 16px; font-weight: 700; white-space: nowrap; }

  .formats { margin-bottom: 64px; }
  .formats .events__h2 { margin-bottom: 22px; }
  .formats__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .formats__item { display: flex; flex-direction: column; gap: 16px; }
  .formats__tile { height: 150px; border: 1.5px solid var(--border); }
  .formats__name { font-size: 21px; font-weight: 500; letter-spacing: -.01em; }
  .formats__count { font-family: var(--font-mono); font-size: 13.2px; color: var(--muted); margin-top: 4px; }

  .calendar__head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 22px; }
  .calendar__season { font-size: 12.2px; color: var(--muted); }
  .calendar { border-top: 1px solid var(--border); }
  .calendar__row {
    display: grid;
    grid-template-columns: 120px 1fr 220px 150px;
    gap: 28px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1.5px solid var(--border-2);
  }
  .calendar__row.is-past { opacity: .5; }
  .calendar__date { font-family: var(--font-mono); font-size: 16px; font-weight: 700; }
  .calendar__title { font-size: 19px; font-weight: 700; letter-spacing: -.01em; }
  .calendar__desc { font-size: 15px; color: var(--slate); margin-top: 4px; }
  .calendar__meta { font-family: var(--font-mono); font-size: 13.6px; color: var(--slate); }
  .calendar__btn { justify-self: end; padding: 11px 22px; font-size: 15px; font-weight: 600; border: 1.5px solid var(--ink); background: var(--white); }
  .calendar__past { justify-self: end; font-family: var(--font-mono); font-size: 13.2px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; }

  @media (max-width: 900px) {
    .events-intro { padding-top: 56px; padding-bottom: 48px; }
    .flagship { grid-template-columns: 1fr; padding: 32px 28px; }
    .flagship__date { text-align: left; padding: 0 0 20px; border-right: 0; border-bottom: 1px solid #3B3D40; }
    .flagship__cta { justify-self: start; }
    .formats__grid { grid-template-columns: 1fr; }
    .calendar__row { grid-template-columns: 1fr; gap: 10px; }
    .calendar__btn, .calendar__past { justify-self: start; }
  }
</style>
