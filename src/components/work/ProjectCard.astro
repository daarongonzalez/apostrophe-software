---
import CardFrame from './CardFrame.astro';
import type { Project } from '../../data/work';

interface Props {
  project: Project;
  num?: string;
}
const { project, num } = Astro.props;
// Only projects with a case study have a page to open.
const href = project.caseStudy ? `/work/${project.slug}` : undefined;
---
<CardFrame kind="Client build" num={num} href={href} spotlight={project.spotlight}>
  <div class="project__img">
    <img src={project.image} alt={project.imageAlt} loading="lazy" />
  </div>
  <div class="project__body">
    <div class="project__tags">
      {project.tags.map((t) => <span>{t}</span>)}
    </div>
    <h3 class="heading project__title">{project.title}</h3>
    <p class="project__summary">{project.summary}</p>
    {href && <span class="project__more">Read the case study →</span>}
  </div>
</CardFrame>

<style>
  .project__img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--card-rule);
    background: var(--surface);
  }
  .project__img img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .project__body { display: flex; flex-direction: column; flex: 1; padding: 22px 24px 26px; }
  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 11.8px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--card-accent);
  }
  .project__title { margin: 0 0 10px; font-size: 21px; line-height: 1.15; }
  .project__summary { font-size: 15.5px; line-height: 1.55; color: var(--card-sub); }
  .project__more { margin-top: auto; padding-top: 20px; font-size: 15px; font-weight: 600; }
</style>
