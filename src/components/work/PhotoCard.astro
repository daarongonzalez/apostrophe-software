---
import type { SessionPhoto } from '../../data/work';

interface Props {
  photo: SessionPhoto;
}
const { photo } = Astro.props;
---
<figure class:list={['photo', `photo--${photo.orientation}`]}>
  <img src={photo.image} alt={photo.alt} loading="lazy" />
  <figcaption>
    <span class="photo__kicker">In the room</span>
    <span class="photo__caption">{photo.caption}</span>
  </figcaption>
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    height: 100%;
    min-height: 340px;
    overflow: hidden;
    border: 1.5px solid var(--ink);
    background: var(--ink);
  }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .photo figcaption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 56px 22px 22px;
    background: linear-gradient(to top, rgba(28,29,31,.92), rgba(28,29,31,.6) 55%, rgba(28,29,31,0));
    color: var(--white);
  }
  .photo__kicker {
    font-family: var(--font-mono);
    font-size: 11.8px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--teal-bright);
  }
  .photo__caption { font-size: 15px; font-weight: 600; line-height: 1.4; }
</style>
