---
// "Noise to signal" scene for the Enablement sprints row.
// A cloud of drifting particles (the noise) settles as the visitor scrolls:
// observe → audit → strategize, ending as the three connected nodes of the
// sprints icon. The cursor clears a patch of noise like a lens.
// The static icon stays in place for reduced motion or when WebGL is missing.
interface Props {
  icon: string;
  alt: string;
}
const { icon, alt } = Astro.props;
const steps = ['Observe', 'Audit', 'Strategize'];
---
<div class="sprints-scene" role="img" aria-label={alt}>
  <div class="sprints-scene__stage" aria-hidden="true">
    <img class="sprints-scene__fallback" src={icon} alt="" loading="lazy" />
  </div>
  <ol class="sprints-scene__steps" aria-hidden="true">
    {steps.map((s) => <li>{s}</li>)}
  </ol>
</div>

<script>
  // Icon layout: left node, top-right node, bottom-right node.
  const NODES: [number, number][] = [[-0.95, 0], [0.75, 0.85], [0.75, -0.85]];
  const EDGES: [number, number][] = [[0, 1], [0, 2]];
  const NODE_R = 0.22;
  const BLUE = [0x1e / 255, 0x76 / 255, 0xc7 / 255];
  const TEAL = [0x1f / 255, 0xc8 / 255, 0xa9 / 255];

  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

  const vertex = /* glsl */ `
    attribute vec3 aTarget;
    attribute float aRole;   // 0 noise, 1 node, 2 edge
    attribute float aSeed;
    uniform float uPhase;
    uniform float uObserve;
    uniform float uAudit;
    uniform float uForm;
    uniform vec2 uMouse;
    uniform float uMouseOn;
    uniform float uPixel;
    varying float vAlpha;
    varying vec3 vColor;

    const vec3 NOISE_COL = vec3(0.64, 0.71, 0.77);
    const vec3 BLUE = vec3(${BLUE.join(',')});
    const vec3 TEAL = vec3(${TEAL.join(',')});

    void main() {
      float s = aSeed * 6.2831;
      vec3 p = position + vec3(
        sin(uPhase * 0.6 + s) * 0.25,
        cos(uPhase * 0.5 + s * 1.3) * 0.25,
        sin(uPhase * 0.4 + s * 0.7) * 0.2
      );
      // Observing: the cloud calms and draws in a little.
      p.xy *= mix(1.0, 0.86, uObserve);

      bool noise = aRole < 0.5;
      float f = smoothstep(0.0, 1.0, clamp((uForm - aSeed * 0.3) / 0.7, 0.0, 1.0));

      if (noise) {
        // Cut the noise: drift out of frame as the plan forms.
        p.xy *= 1.0 + uForm * 0.7;
      } else {
        vec3 wobble = vec3(sin(uPhase * 0.9 + s), cos(uPhase * 0.8 + s), 0.0) * 0.015;
        p = mix(p, aTarget + wobble, f);
      }

      // Cursor lens pushes particles aside until the shape has formed.
      vec2 d = p.xy - uMouse;
      float len = length(d);
      float lens = 0.75;
      if (len < lens && len > 0.0001) {
        float push = (lens - len) * 0.9 * uMouseOn * (1.0 - f);
        p.xy += normalize(d) * push;
      }

      vec4 mv = modelViewMatrix * vec4(p, 1.0);
      gl_Position = projectionMatrix * mv;

      float size = 5.0;
      vec3 brand = mix(BLUE, TEAL, clamp((aTarget.x + 1.2) / 2.2, 0.0, 1.0));
      if (noise) {
        size *= mix(1.0, 0.65, uAudit);
        vAlpha = mix(0.55, 0.16, uAudit) * (1.0 - uForm);
        vColor = NOISE_COL;
      } else {
        size *= mix(1.0, 1.3, uAudit);
        vAlpha = mix(0.55, 0.95, uAudit);
        vColor = mix(NOISE_COL, brand, uAudit);
      }
      gl_PointSize = size * uPixel * (8.0 / -mv.z);
    }
  `;

  const fragment = /* glsl */ `
    varying float vAlpha;
    varying vec3 vColor;
    void main() {
      float d = length(gl_PointCoord - 0.5);
      float a = vAlpha * smoothstep(0.5, 0.32, d);
      if (a < 0.01) discard;
      gl_FragColor = vec4(vColor, a);
    }
  `;

  async function start(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('.sprints-scene__stage')!;
    const steps = Array.from(root.querySelectorAll<HTMLElement>('.sprints-scene__steps li'));
    // The whole image area drives scroll progress, not just the circle.
    const track = (root.closest('.glass') as HTMLElement) || root;

    const THREE = await import('three');

    let renderer: InstanceType<typeof THREE.WebGLRenderer>;
    try {
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'low-power' });
    } catch {
      return; // No WebGL: keep the static icon.
    }
    renderer.setClearColor(0x000000, 0);
    renderer.domElement.className = 'sprints-scene__canvas';

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 50);
    camera.position.set(0, 0, 8);
    const halfView = Math.tan(THREE.MathUtils.degToRad(15)) * 8;

    // ─── Particles ───
    const small = window.matchMedia('(max-width: 600px)').matches;
    const count = small ? 520 : 900;
    const pos = new Float32Array(count * 3);
    const target = new Float32Array(count * 3);
    const role = new Float32Array(count);
    const seed = new Float32Array(count);

    for (let i = 0; i < count; i++) {
      const a = Math.random() * Math.PI * 2;
      const r = Math.sqrt(Math.random()) * 2.0;
      pos.set([Math.cos(a) * r, Math.sin(a) * r, (Math.random() - 0.5) * 2], i * 3);
      seed[i] = Math.random();

      const pick = Math.random();
      if (pick < 0.22) {
        // Node cluster: points spread over a small sphere.
        const [nx, ny] = NODES[i % 3];
        const u = Math.random() * Math.PI * 2;
        const v = Math.acos(2 * Math.random() - 1);
        const rr = NODE_R * Math.cbrt(Math.random()) * 0.95;
        target.set([nx + rr * Math.sin(v) * Math.cos(u), ny + rr * Math.sin(v) * Math.sin(u), rr * Math.cos(v)], i * 3);
        role[i] = 1;
      } else if (pick < 0.4) {
        // Edge: points along a connecting line, clear of the nodes.
        const [ia, ib] = EDGES[i % 2];
        const t = 0.15 + Math.random() * 0.7;
        const [ax, ay] = NODES[ia];
        const [bx, by] = NODES[ib];
        target.set([ax + (bx - ax) * t, ay + (by - ay) * t, (Math.random() - 0.5) * 0.04], i * 3);
        role[i] = 2;
      } else {
        target.set([pos[i * 3], pos[i * 3 + 1], pos[i * 3 + 2]], i * 3);
        role[i] = 0;
      }
    }

    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geo.setAttribute('aTarget', new THREE.BufferAttribute(target, 3));
    geo.setAttribute('aRole', new THREE.BufferAttribute(role, 1));
    geo.setAttribute('aSeed', new THREE.BufferAttribute(seed, 1));

    const uniforms = {
      uPhase: { value: 0 },
      uObserve: { value: 0 },
      uAudit: { value: 0 },
      uForm: { value: 0 },
      uMouse: { value: new THREE.Vector2(99, 99) },
      uMouseOn: { value: 0 },
      uPixel: { value: 1 },
    };
    const points = new THREE.Points(
      geo,
      new THREE.ShaderMaterial({ vertexShader: vertex, fragmentShader: fragment, uniforms, transparent: true, depthWrite: false }),
    );
    scene.add(points);

    // ─── Glass nodes that settle in at the end ───
    scene.add(new THREE.HemisphereLight(0xffffff, 0xcfe6f2, 1.6));
    const sun = new THREE.DirectionalLight(0xffffff, 1.4);
    sun.position.set(2, 3, 5);
    scene.add(sun);

    const sphereGeo = new THREE.SphereGeometry(NODE_R, 40, 24);
    const spheres = NODES.map(([x, y]) => {
      const t = clamp01((x + 1.2) / 2.2);
      const color = new THREE.Color().setRGB(
        BLUE[0] + (TEAL[0] - BLUE[0]) * t,
        BLUE[1] + (TEAL[1] - BLUE[1]) * t,
        BLUE[2] + (TEAL[2] - BLUE[2]) * t,
      );
      const mesh = new THREE.Mesh(
        sphereGeo,
        new THREE.MeshPhysicalMaterial({ color, roughness: 0.25, clearcoat: 1, clearcoatRoughness: 0.15, transparent: true, opacity: 0.92 }),
      );
      mesh.position.set(x, y, 0);
      mesh.scale.setScalar(0.001);
      scene.add(mesh);
      return mesh;
    });

    // ─── Sizing ───
    function resize() {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      if (!w || !h) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      renderer.setPixelRatio(dpr);
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      // Keep point sizes consistent with the 316px design circle.
      uniforms.uPixel.value = dpr * (h / 316);
    }
    new ResizeObserver(resize).observe(stage);
    resize();

    // ─── Cursor lens ───
    let mouseTarget = 0;
    stage.addEventListener('pointermove', (e) => {
      const r = stage.getBoundingClientRect();
      const nx = ((e.clientX - r.left) / r.width) * 2 - 1;
      const ny = -(((e.clientY - r.top) / r.height) * 2 - 1);
      uniforms.uMouse.value.set(nx * halfView * camera.aspect, ny * halfView);
      mouseTarget = 1;
    });
    stage.addEventListener('pointerleave', () => { mouseTarget = 0; });

    // ─── Scroll progress ───
    function scrollTarget() {
      const r = track.getBoundingClientRect();
      const vh = window.innerHeight;
      const center = r.top + r.height / 2;
      // 0 as the image area enters from below, 1 once its centre reaches ~45% of the viewport.
      return clamp01((vh - center) / (vh * 0.55));
    }

    // ─── Loop (paused when off screen) ───
    let progress = scrollTarget();
    let visible = false;
    let raf = 0;
    let last = performance.now();
    let activeStep = -1;

    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;

      progress += (scrollTarget() - progress) * Math.min(1, dt * 5);
      const observe = clamp01(progress / 0.33);
      const audit = clamp01((progress - 0.33) / 0.33);
      const form = clamp01((progress - 0.66) / 0.34);

      uniforms.uObserve.value = observe;
      uniforms.uAudit.value = audit;
      uniforms.uForm.value = form;
      uniforms.uPhase.value += dt * (1 - observe * 0.65);
      uniforms.uMouseOn.value += (mouseTarget - uniforms.uMouseOn.value) * Math.min(1, dt * 6);

      const grow = THREE.MathUtils.smoothstep(form, 0.75, 1);
      const t = now / 1000;
      spheres.forEach((m, i) => {
        m.scale.setScalar(Math.max(0.001, grow));
        m.position.z = Math.sin(t * 1.2 + i * 2) * 0.05 * grow;
      });
      // A slow turn so the cloud reads as 3D, settling flat once formed.
      points.rotation.y = Math.sin(t * 0.25) * 0.35 * (1 - form);

      const step = progress < 0.33 ? 0 : progress < 0.66 ? 1 : 2;
      if (step !== activeStep) {
        activeStep = step;
        steps.forEach((el, i) => el.classList.toggle('is-active', i === step));
      }

      renderer.render(scene, camera);
      raf = visible ? requestAnimationFrame(frame) : 0;
    }

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !raf) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    }).observe(stage);

    stage.appendChild(renderer.domElement);
    root.dataset.live = '';
  }

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('.sprints-scene').forEach((root) => {
      // Load three.js only when the visitor gets close to the section.
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          start(root).catch(() => { /* keep the static icon */ });
        },
        { rootMargin: '400px 0px' },
      );
      io.observe(root);
    });
  }
</script>

<style>
  .sprints-scene {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .sprints-scene__stage {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sprints-scene__fallback { height: 210px; width: auto; }
  .sprints-scene__stage :global(.sprints-scene__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: crosshair;
  }
  .sprints-scene[data-live] .sprints-scene__fallback { visibility: hidden; }

  /* Step labels sit under the ring once the scene is running */
  .sprints-scene__steps {
    position: absolute;
    left: 50%;
    top: calc(100% + 30px);
    transform: translateX(-50%);
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    opacity: 0;
    transition: opacity .4s ease;
  }
  .sprints-scene[data-live] .sprints-scene__steps { opacity: 1; }
  .sprints-scene__steps li {
    position: relative;
    padding-bottom: 5px;
    transition: color .3s ease;
  }
  .sprints-scene__steps li::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, #1E76C7, #1FC8A9);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .45s cubic-bezier(.65,0,.35,1);
  }
  .sprints-scene__steps li.is-active { color: var(--ink); }
  .sprints-scene__steps li.is-active::after { transform: scaleX(1); }

  @media (max-width: 560px) {
    .sprints-scene__fallback { height: 168px; }
    .sprints-scene__steps { top: calc(100% + 24px); gap: 16px; font-size: 11px; }
  }
</style>
